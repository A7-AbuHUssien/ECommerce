@model IEnumerable<Product>
@{
    ViewData["Title"] = "Store";
}

<header class="hero-section-slim">
    <div class="container px-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="hero-title-slim">Shop in <span class="text-primary">Style.</span></h1>
                <p class="hero-subtitle-slim">Exclusive collection with premium quality.</p>
            </div>
            <div class="d-none d-md-block text-primary opacity-25">
                <i class="bi bi-stars fs-1"></i>
            </div>
        </div>
    </div>
</header>

<div class="container">
    <section class="filter-wrapper mb-5">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="small fw-bold text-muted mb-2">Search Product</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="E.g. Sneakers..." 
                               name="ProductName" value="@Context.Request.Query["ProductName"]">
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="small fw-bold text-muted mb-2">Category</label>
                    <select name="CategoryId" class="form-select">
                        <option value="">All Categories</option>
                        @if (ViewData["Categories"] is IEnumerable<Category> categories)
                        {
                            @foreach (var item in categories)
                            {
                                <option value="@item.Id" selected="@(item.Id.ToString() == Context.Request.Query["CategoryId"])">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="small fw-bold text-muted mb-2">Price Range</label>
                    <div class="d-flex gap-2">
                        <input type="number" class="form-control" placeholder="Min" name="MinPrice" value="@Context.Request.Query["MinPrice"]">
                        <input type="number" class="form-control" placeholder="Max" name="MaxPrice" value="@Context.Request.Query["MaxPrice"]">
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="IsHot" value="true" id="hotSwitch" 
                               @(Context.Request.Query["IsHot"] == "true" ? "checked" : "")>
                        <label class="form-check-label fw-bold" for="hotSwitch">🔥 Hot Deals</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Apply Filters
                    </button>
                </div>
            </div>
        </form>
    </section>

    <section class="pb-5">
        <div class="row gx-4 gy-5">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-xl-3">
                    <div class="card product-card h-100">
                        <div class="position-absolute p-3 w-100 d-flex justify-content-between align-items-start" style="z-index: 2;">
                            <span class="badge badge-category shadow-sm">@item.Category.Name</span>
                            @if (item.Discount > 0)
                            {
                                <span class="badge bg-danger rounded-pill shadow-sm">-@item.Discount%</span>
                            }
                        </div>

                        <a asp-area="Customer" asp-controller="Home" asp-action="Item" asp-route-id="@item.Id" class="text-decoration-none">
                            <img class="card-img-top" src="~/Uploads/Product/@item.MainImg" alt="@item.Name" 
                                 onerror="this.src='https://placehold.jp/400x500.png?text=No+Image'"/>
                            
                            <div class="card-body p-4">
                                <div class="text-center">
                                    <h6 class="fw-bold text-dark mb-1">@item.Name</h6>
                                    <div class="d-flex justify-content-center small text-warning mb-3">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= item.Rate ? "bi-star-fill" : "bi-star")"></i>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        @if (item.Discount > 0)
                                        {
                                            <span class="price-old">@item.Price.ToString("C")</span>
                                            <span class="price-new">@((item.Price - (item.Price * item.Discount / 100)).ToString("C"))</span>
                                        }
                                        else
                                        {
                                            <span class="price-new">@item.Price.ToString("C")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>

                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                            <form asp-area="Customer" asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="productId" value="@item.Id"/>
                                <input type="hidden" name="count" value="1"/>
                                <button type="submit" class="btn btn-outline-dark w-100 rounded-pill fw-bold">
                                    <i class="bi bi-cart-plus me-2"></i>Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <div class="row mt-4">
        <div class="col-12 d-flex justify-content-center">
            <nav>
                <ul class="pagination shadow-sm">
                    @for (int i = 1; i <= ViewBag.totalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@i" 
                               asp-route-ProductName="@Context.Request.Query["ProductName"]"
                               asp-route-CategoryId="@Context.Request.Query["CategoryId"]"
                               asp-route-MinPrice="@Context.Request.Query["MinPrice"]"
                               asp-route-MaxPrice="@Context.Request.Query["MaxPrice"]"
                               asp-route-IsHot="@Context.Request.Query["IsHot"]">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>
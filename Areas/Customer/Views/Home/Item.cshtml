@model Product
@{
    ViewData["Title"] = Model.Name;
    var discountedPrice = Model.Price - (Model.Price * Model.Discount / 100);
}

<section class="py-5">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 align-items-start">
            
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="main-img-container mb-3 shadow-sm rounded-4 overflow-hidden bg-white">
                    <img id="mainImage" class="img-fluid w-100 h-100" 
                         src="~/Uploads/Product/@Model.MainImg"
                         alt="@Model.Name" 
                         style="aspect-ratio: 1/1; object-fit: contain; transition: 0.3s ease;"/>
                </div>

                <div class="row gx-2 flex-nowrap overflow-auto pb-2 custom-scrollbar">
                    <div class="col-3">
                        <div class="thumb-wrapper shadow-sm rounded-3 overflow-hidden">
                            <img class="img-fluid gallery-thumb thumb-active"
                                 src="~/Uploads/Product/@Model.MainImg"
                                 onclick="updateGallery(this)"
                                 role="button"/>
                        </div>
                    </div>
                    @foreach (var subImg in Model.SubImages)
                    {
                        <div class="col-3">
                            <div class="thumb-wrapper shadow-sm rounded-3 overflow-hidden">
                                <img class="img-fluid gallery-thumb"
                                     src="~/Uploads/Product/ProductSubImg/@subImg.Img"
                                     onclick="updateGallery(this)"
                                     role="button"/>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-6 ps-md-5">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb small text-uppercase fw-bold letter-spacing-1">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Store</a></li>
                        <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">@Model.Category.Name</a></li>
                        <li class="breadcrumb-item active text-primary">@Model.Brand?.Name</li>
                    </ol>
                </nav>
                
                <h1 class="display-6 fw-bold mb-2">@Model.Name</h1>
                
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="text-warning small">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Model.Rate ? "bi-star-fill" : "bi-star")"></i>
                        }
                    </div>
                    <span class="text-muted small">(@Model.Rate.ToString("0.0") Rating)</span>
                </div>

                <div class="price-box mb-4 p-3 bg-light rounded-3 d-inline-block w-100">
                    <div class="d-flex align-items-center gap-2">
                        <span class="h2 fw-bold text-primary mb-0">@discountedPrice.ToString("c")</span>
                        @if (Model.Discount > 0)
                        {
                            <span class="text-muted text-decoration-line-through small">@Model.Price.ToString("c")</span>
                            <span class="badge bg-danger rounded-pill shadow-sm">SAVE @Model.Discount%</span>
                        }
                    </div>
                </div>

                <p class="text-muted mb-4 lh-lg">@Model.Description</p>

                @if (Model.Colors != null && Model.Colors.Any())
                {
                    <div class="mb-4">
                        <h6 class="fw-bold small text-uppercase mb-3">Available Colors</h6>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var productColor in Model.Colors)
                            {
                                var colorId = "color-" + productColor.Color;
                                <div class="color-item">
                                    <input type="radio" name="selectedColor" value="@productColor.Color" id="@colorId" class="btn-check" required>
                                    <label class="btn color-swatch shadow-sm" for="@colorId" 
                                           style="background-color: @productColor.Color;"
                                           data-bs-toggle="tooltip" title="@productColor.Color"></label>
                                </div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="AddToCart" asp-controller="Cart" class="mt-4">
                    <input type="hidden" name="productId" value="@Model.Id">
                    <div class="row g-3">
                        <div class="col-3 col-lg-2">
                            <label class="small fw-bold text-muted d-block mb-2">Qty</label>
                            <input class="form-control form-control-lg border-2 text-center" id="inputQuantity" type="number" name="count" value="1" min="1"/>
                        </div>
                        <div class="col-9 col-lg-10 d-flex align-items-end">
                            <button class="btn btn-primary btn-lg w-100 shadow py-3 fw-bold" type="submit">
                                <i class="bi bi-cart-plus-fill me-2"></i> Add to Shopping Bag
                            </button>
                        </div>
                    </div>
                </form>

                <div class="mt-5 border-top pt-4">
                    <div class="row g-3">
                        <div class="col-6 small"><i class="bi bi-truck me-2 text-primary"></i> Free Express Shipping</div>
                        <div class="col-6 small"><i class="bi bi-shield-check me-2 text-primary"></i> 2 Years Warranty</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white border-top">
    <div class="container px-4 px-lg-5">
        <h3 class="fw-bold mb-4">You May Also Like</h3>
        <div class="row gx-4 gy-4 row-cols-2 row-cols-md-3 row-cols-xl-4">
            @foreach (var item in ViewBag.relatedProduct)
            {
                <div class="col">
                    <div class="card h-100 product-card border-0 shadow-sm">
                        <img class="card-img-top" src="~/Uploads/Product/@item.MainImg" alt="@item.Name" />
                        <div class="card-body p-3 text-center">
                            <h6 class="fw-bold text-truncate mb-1">@item.Name</h6>
                            <p class="text-primary fw-bold mb-0">@((item.Price - item.Price * item.Discount / 100).ToString("c"))</p>
                        </div>
                        <div class="card-footer p-3 pt-0 border-top-0 bg-transparent">
                            <a class="btn btn-sm btn-outline-dark w-100 rounded-pill" asp-action="Item" asp-route-id="@item.Id">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
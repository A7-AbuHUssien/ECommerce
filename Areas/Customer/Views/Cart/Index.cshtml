@model IEnumerable<Cart>
@{
    ViewData["Title"] = "Shopping Cart";
    decimal subTotal = 0;
}

<section class="py-5 bg-light">
    <div class="container">
        <h2 class="fw-bold mb-4">Shopping <span class="text-primary">Cart</span></h2>

        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="bi bi-cart-x display-1 text-muted"></i>
                <p class="lead mt-3">Your cart is empty!</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">Start Shopping</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    @foreach (var item in Model)
                    {
                        var itemPrice = item.Price - (item.Price * item.Product.Discount / 100);
                        var itemTotal = itemPrice * item.Count;
                        subTotal += itemTotal;

                        <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                            <div class="card-body p-3">
                                <div class="row align-items-center">
                                    <div class="col-4 col-md-2">
                                        <img src="~/Uploads/Product/@item.Product.MainImg" 
                                             class="img-fluid rounded-3 border" alt="@item.Product.Name">
                                    </div>
                                    
                                    <div class="col-8 col-md-4">
                                        <h6 class="fw-bold mb-1">@item.Product.Name</h6>
                                        <p class="small text-muted mb-0 text-truncate" style="max-width: 200px;">
                                            @item.Product.Description
                                        </p>
                                    </div>

                                    <div class="col-6 col-md-3 mt-3 mt-md-0">
                                        <div class="d-flex align-items-center justify-content-center border rounded-pill p-1 bg-light">
                                            <a asp-action="DecrementCount" asp-route-productId="@item.ProductId" 
                                               class="btn btn-sm btn-link text-dark p-0 px-2"><i class="bi bi-dash-lg"></i></a>
                                            
                                            <input readonly value="@item.Count" type="number" 
                                                   class="form-control form-control-sm text-center border-0 bg-transparent fw-bold" 
                                                   style="width: 40px;" />
                                            
                                            <a asp-action="IncrementCount" asp-route-productId="@item.ProductId" 
                                               class="btn btn-sm btn-link text-dark p-0 px-2"><i class="bi bi-plus-lg"></i></a>
                                        </div>
                                    </div>

                                    <div class="col-4 col-md-2 text-end mt-3 mt-md-0">
                                        <span class="fw-bold text-primary">@itemTotal.ToString("c")</span>
                                    </div>

                                    <div class="col-2 col-md-1 text-end mt-3 mt-md-0">
                                        <a asp-action="DeleteProduct" asp-route-productId="@item.ProductId" 
                                           class="btn btn-sm btn-outline-danger border-0 rounded-circle">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link text-decoration-none text-muted p-0 mt-2">
                        <i class="bi bi-arrow-left"></i> Continue Shopping
                    </a>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 100px;">
                        <h5 class="fw-bold mb-4">Order Summary</h5>
                        
                        <form asp-action="Index" class="mb-4">
                            <div class="input-group">
                                <input name="code" type="text" class="form-control border-end-0 rounded-start-pill" placeholder="Promo Code">
                                <button class="btn btn-dark rounded-end-pill px-3" type="submit">Apply</button>
                            </div>
                        </form>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold">@subTotal.ToString("c")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Shipping</span>
                            <span class="text-success fw-bold">Free</span>
                        </div>
                        <hr class="my-3">
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold">Total</span>
                            <span class="h5 fw-bold text-primary">@subTotal.ToString("c")</span>
                        </div>

                        <a asp-action="Pay" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow">
                            Proceed to Checkout <i class="bi bi-credit-card ms-2"></i>
                        </a>

                        <div class="mt-4 d-flex justify-content-center gap-3 text-muted">
                            <i class="bi bi-shield-lock fs-4"></i>
                            <i class="bi bi-wallet2 fs-4"></i>
                            <i class="bi bi-truck fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
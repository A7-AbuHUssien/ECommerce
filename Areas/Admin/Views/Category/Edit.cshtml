@model Category

@{
    ViewData["Title"] = "Edit Category";
    Layout = "_AdminLayout";  
}

<div class="container-fluid px-4 mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/Admin/" class="text-decoration-none" style="color: #764ba2;">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: #764ba2;">Categories</a></li>
            <li class="breadcrumb-item active">Edit Category</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header py-3 border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h5 class="mb-0 text-white fw-bold">
                        <i class="fas fa-edit me-2"></i>Modify Category: @Model.Name
                    </h5>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-12 mb-4">
                                <label asp-for="Name" class="form-label fw-bold" style="color: #2c3e50;">Category Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0 text-muted">
                                        <i class="fas fa-folder-open"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control bg-light border-0 py-2" 
                                           style="border-radius: 0 10px 10px 0;" placeholder="Enter category name..." />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mb-4">
                                <label asp-for="Description" class="form-label fw-bold" style="color: #2c3e50;">Description</label>
                                <textarea asp-for="Description" class="form-control bg-light border-0" 
                                          rows="5" style="border-radius: 12px;" placeholder="Describe this category..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mb-4">
                                <div class="p-3 rounded-4" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                                    <div class="form-check form-switch mb-0 d-flex align-items-center">
                                        <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" 
                                               id="statusSwitch" style="width: 2.6em; height: 1.3em; cursor: pointer;" />
                                        <label class="form-check-label ms-3 fw-bold" for="statusSwitch" style="color: #2c3e50;">
                                            Current Status: <span class="@(Model.Status ? "text-success" : "text-danger")">@(Model.Status ? "Active" : "Inactive")</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5 opacity-25">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-light px-4 fw-bold text-muted border-0" 
                               style="border-radius: 12px; background: #f1f5f9;">
                                <i class="fas fa-times me-1"></i> Discard
                            </a>
                            <button type="submit" class="btn text-white px-5 fw-bold shadow-sm" 
                                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 12px;">
                                <i class="fas fa-check-circle me-1"></i> Update Category
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4 text-center">
                <span class="badge bg-light text-muted border px-3 py-2" style="border-radius: 8px;">
                    <i class="fas fa-info-circle me-1"></i> Last update ID: #@Model.Id
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
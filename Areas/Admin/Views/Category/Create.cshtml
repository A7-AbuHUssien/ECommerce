@model Category

@{
    ViewData["Title"] = "Create Category";
    Layout = "_AdminLayout";  
}

<div class="container-fluid px-4 mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/Admin/" class="text-decoration-none" style="color: #764ba2;">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: #764ba2;">Categories</a></li>
            <li class="breadcrumb-item active">New Category</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header py-3 border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h5 class="mb-0 text-white fw-bold">
                        <i class="fas fa-layer-group me-2"></i>Create New Category
                    </h5>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold" style="color: #2c3e50;">Category Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-folder-open"></i></span>
                                <input asp-for="Name" class="form-control bg-light border-0 py-2" style="border-radius: 0 10px 10px 0;" placeholder="e.g. Electronics, Fashion, Home..." />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold" style="color: #2c3e50;">Description</label>
                            <textarea asp-for="Description" class="form-control bg-light border-0" rows="5" style="border-radius: 12px;" placeholder="What kind of products belong here?"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px dashed #e2e8f0;">
                                <div class="form-check form-switch mb-0 d-flex align-items-center">
                                    <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" id="statusSwitch" style="width: 2.5em; height: 1.25em; cursor: pointer;" checked />
                                    <label class="form-check-label ms-3 fw-bold" for="statusSwitch" style="color: #2c3e50;">Active & Visible in Store</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 opacity-25">

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light px-4 fw-bold text-muted border-0" style="border-radius: 10px; background: #f1f5f9;">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn text-white px-5 fw-bold shadow-sm" 
                                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 10px;">
                                <i class="fas fa-save me-1"></i> Save Category
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="mt-4 text-center">
                <p class="small text-muted">
                    <i class="fas fa-lightbulb text-warning me-1"></i> 
                    <strong>Tip:</strong> Categories help customers find products faster. Use clear, concise names.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
@model Promotion
@{
    ViewData["Title"] = "Create Promotion";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/Admin/" class="text-decoration-none" style="color: #764ba2;">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: #764ba2;">Promotions</a></li>
            <li class="breadcrumb-item active">New Promo</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header py-4 border-0 text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="mb-2">
                        <i class="fas fa-ticket-alt text-white opacity-75" style="font-size: 2rem;"></i>
                    </div>
                    <h4 class="mb-0 text-white fw-bold">Create Promotion</h4>
                    <p class="small text-white opacity-75 mb-0">Define discounts for your customers</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="mb-4">
                            <label asp-for="Code" class="form-label fw-bold small text-muted text-uppercase">Promo Code</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-barcode"></i></span>
                                <input asp-for="Code" class="form-control bg-light border-0 py-2" style="border-radius: 0 10px 10px 0;" placeholder="e.g. WINTER2026" />
                            </div>
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <label asp-for="Discount" class="form-label fw-bold small text-muted text-uppercase">Discount %</label>
                                <div class="input-group">
                                    <input asp-for="Discount" type="number" class="form-control bg-light border-0 py-2" style="border-radius: 10px 0 0 10px;" />
                                    <span class="input-group-text bg-light border-0 fw-bold">%</span>
                                </div>
                                <span asp-validation-for="Discount" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="MaxUsage" class="form-label fw-bold small text-muted text-uppercase">Usage Limit</label>
                                <input asp-for="MaxUsage" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" placeholder="e.g. 100" />
                                <span asp-validation-for="MaxUsage" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase">Target Product</label>
                            <select asp-for="ProductId" asp-items="ViewBag.ProductList" class="form-select bg-light border-0 py-2" style="border-radius: 10px;">
                                <option disabled selected>-- Select a Product --</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ValidTo" class="form-label fw-bold small text-muted text-uppercase">Expiry Date</label>
                            <input asp-for="ValidTo" type="date" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" />
                            <span asp-validation-for="ValidTo" class="text-danger small"></span>
                        </div>

                        <div class="p-3 rounded-4 mb-4" style="background: #f8fafc; border: 1px dashed #e2e8f0;">
                            <div class="form-check form-switch d-flex align-items-center">
                                <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="IsValid" checked style="width: 2.5em; height: 1.25em;">
                                <label class="form-check-label fw-bold" asp-for="IsValid" style="color: #2c3e50;">Activate Promotion Now</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn text-white btn-lg fw-bold shadow-sm" 
                                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 12px;">
                                <i class="fas fa-check-circle me-2"></i>Save Promotion
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none small fw-bold mt-2">
                                <i class="fas fa-arrow-left me-1"></i> Back to list
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
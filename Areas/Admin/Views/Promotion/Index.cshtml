@model IEnumerable<Promotion>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-ticket-perforated me-2"></i>Promotions Management</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> New Promo
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Promo Code</th>
                    <th>Product</th>
                    <th>Discount</th>
                    <th>Expiry Date</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-primary">@item.Code</td>
                        <td>@item.Product?.Name</td>
                        <td><span class="badge bg-success-subtle text-success">@item.Discount.ToString("0")% OFF</span></td>
                        <td>@item.ValidTo.ToShortDateString()</td>
                        <td>
                            @if (item.IsValid)
                            {
                                <span class="badge rounded-pill bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <form asp-action="ActivateDeactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(item.IsValid ? "btn-outline-danger" : "btn-outline-success") rounded-circle" title="Toggle Status">
                                    <i class="bi @(item.IsValid ? "bi-slash-circle" : "bi-check-circle")"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-circle ms-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
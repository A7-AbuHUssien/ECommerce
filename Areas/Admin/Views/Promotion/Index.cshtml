@model IEnumerable<Promotion>
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color: #2c3e50;"><i class="fas fa-percentage me-2 text-primary"></i>Marketing Promotions</h2>
            <p class="text-muted small mb-0">Manage coupons and discount events.</p>
        </div>
        <a asp-action="Create" class="btn text-white px-4 fw-bold shadow-sm" 
           style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 10px;">
            <i class="fas fa-plus-circle me-1"></i> New Promo
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted small fw-bold text-uppercase">Code</th>
                        <th class="py-3 text-muted small fw-bold text-uppercase">Product</th>
                        <th class="py-3 text-muted small fw-bold text-uppercase text-center">Discount</th>
                        <th class="py-3 text-muted small fw-bold text-uppercase">Expiry</th>
                        <th class="py-3 text-muted small fw-bold text-uppercase text-center">Status</th>
                        <th class="text-end pe-4 py-3 text-muted small fw-bold text-uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold" style="color: #764ba2;">@item.Code</td>
                            <td>
                                <div class="fw-bold text-dark">@item.Product?.Name</div>
                                <div class="text-muted small">Target Product</div>
                            </td>
                            <td class="text-center">
                                <span class="badge px-3 py-2 fw-bold" style="background: #eeebff; color: #764ba2; border-radius: 8px;">
                                    @item.Discount.ToString("0")% OFF
                                </span>
                            </td>
                            <td>
                                <div class="small fw-bold">@item.ValidTo.ToShortDateString()</div>
                                @if(item.ValidTo < DateTime.Now) {
                                    <span class="text-danger small fw-bold" style="font-size: 10px;">EXPIRED</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsValid)
                                {
                                    <span class="badge rounded-pill px-3 py-1 bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-1 bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="ActivateDeactivate" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-sm shadow-sm @(item.IsValid ? "btn-light text-danger" : "btn-light text-success")" 
                                                style="border-radius: 8px;" title="Toggle Status">
                                            <i class="fas @(item.IsValid ? "fa-power-off" : "fa-play")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light shadow-sm text-dark" 
                                       style="border-radius: 8px;" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
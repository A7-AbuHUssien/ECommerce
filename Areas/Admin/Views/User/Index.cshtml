@model IEnumerable<ApplicationUser>
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color: #2c3e50;"><i class="fas fa-users-cog me-2 text-primary"></i>Staff & Customers</h2>
            <p class="text-muted small mb-0">Manage access levels and monitor account status.</p>
        </div>
        <a asp-action="Create" class="btn text-white px-4 fw-bold shadow-sm" 
           style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 10px;">
            <i class="fas fa-plus-circle me-1"></i> Create New User
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted small fw-bold text-uppercase">Identity</th>
                        <th class="py-3 text-muted small fw-bold text-uppercase">Contact Info</th>
                        <th class="py-3 text-muted small fw-bold text-uppercase text-center">Account Status</th>
                        <th class="text-end pe-4 py-3 text-muted small fw-bold text-uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isLocked = user.LockoutEnd != null && user.LockoutEnd > DateTime.UtcNow;
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="shadow-sm d-flex align-items-center justify-content-center fw-bold text-white" 
                                         style="width: 45px; height: 45px; border-radius: 12px; background: linear-gradient(135deg, #a5b4fc, #6366f1); font-size: 1.2rem;">
                                        @user.Name[0].ToString().ToUpper()
                                    </div>
                                    <div class="ms-3">
                                        <div class="fw-bold text-dark">@user.Name</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@@@user.UserName</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-bold text-dark"><i class="fas fa-envelope me-1 text-muted"></i> @user.Email</div>
                                <div class="small text-muted"><i class="fas fa-phone me-1"></i> @(user.PhoneNumber ?? "No Phone")</div>
                            </td>
                            <td class="text-center">
                                @if (isLocked)
                                {
                                    <span class="badge px-3 py-2" style="background: #fee2e2; color: #ef4444; border-radius: 8px;">
                                        <i class="fas fa-user-slash me-1"></i> Blocked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge px-3 py-2" style="background: #dcfce7; color: #16a34a; border-radius: 8px;">
                                        <i class="fas fa-user-check me-1"></i> Active
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-light shadow-sm" 
                                       style="border-radius: 8px; color: #764ba2;" title="Edit Profile">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="LockUnlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @if (isLocked)
                                        {
                                            <button type="submit" class="btn btn-sm btn-light text-success shadow-sm" style="border-radius: 8px;"
                                                    onclick="return confirm('Unlock this user?');" title="Unblock">
                                                <i class="fas fa-unlock"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-light text-danger shadow-sm" style="border-radius: 8px;"
                                                    onclick="return confirm('Block this user?');" title="Block">
                                                <i class="fas fa-lock"></i>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
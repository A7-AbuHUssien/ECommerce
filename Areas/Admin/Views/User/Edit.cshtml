@model ApplicationUser
@{
    ViewData["Title"] = "Edit User";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header py-4 border-0 text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h4 class="mb-0 text-white fw-bold"><i class="fas fa-user-edit me-2"></i>Edit Profile</h4>
                    <p class="small text-white opacity-75 mb-0">Modifying account for: <strong>@Model.Email</strong></p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold small text-muted text-uppercase">Full Name</label>
                                <input asp-for="Name" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold small text-muted text-uppercase">Email Address</label>
                                <input asp-for="Email" class="form-control border-0 py-2" style="border-radius: 10px; background: #eef2f7;" readonly />
                                <small class="text-muted">Email cannot be changed</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold small text-muted text-uppercase">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Account Role</label>
                                <select name="selectedRole" class="form-select bg-light border-0 py-2" style="border-radius: 10px;">
                                    @foreach (var role in ViewBag.RoleList)
                                    {
                                        <option value="@role" selected="@(role == ViewBag.CurrentUserRole)">@role</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold small text-muted text-uppercase">Address</label>
                                <input asp-for="Address" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" />
                            </div>
                        </div>

                        <hr class="my-5 opacity-25">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-light px-4 fw-bold text-muted border-0" style="border-radius: 12px;">Cancel</a>
                            <button type="submit" class="btn text-white px-5 fw-bold shadow-sm" 
                                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 12px;">
                                <i class="fas fa-save me-1"></i> Update User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
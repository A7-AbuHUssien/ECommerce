@model Product

@{
    ViewData["Title"] = "Product Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/Admin/" class="text-decoration-none" style="color: #764ba2;">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: #764ba2;">Products</a></li>
            <li class="breadcrumb-item active">View Details</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-xl-5 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 20px; overflow: hidden;">
                <div class="card-body p-4 text-center">
                    <div class="p-3 mb-4 bg-white shadow-sm border" style="border-radius: 15px;">
                        <a href="@Url.Content("~/Uploads/product/" + Model.MainImg)" target="_blank">
                            <img src="@Url.Content("~/Uploads/product/" + Model.MainImg)"
                                 alt="@Model.Name"
                                 class="img-fluid rounded-3"
                                 style="max-height: 400px; width: 100%; object-fit: contain;">
                        </a>
                    </div>

                    @if (Model.SubImages != null && Model.SubImages.Any())
                    {
                        <h6 class="text-start fw-bold text-muted mb-3 small text-uppercase">Gallery Images</h6>
                        <div class="d-flex flex-wrap gap-2 justify-content-start">
                            @foreach (var sub in Model.SubImages)
                            {
                                <a href="@Url.Content("~/Uploads/product/ProductSubImg/" + sub.Img)" target="_blank" class="gallery-item">
                                    <img src="@Url.Content("~/Uploads/product/ProductSubImg/" + sub.Img)"
                                         alt="@sub.Img"
                                         class="img-thumbnail border-0 shadow-sm"
                                         style="width: 80px; height: 80px; object-fit: cover; border-radius: 10px;">
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-7 mb-4">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-header py-4 border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0 text-white fw-bold">@Model.Name</h4>
                        <span class="badge px-3 py-2 fw-bold" style="background: rgba(255,255,255,0.2); border-radius: 10px;">
                            SKU: @Model.SKU
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <span class="display-5 fw-bold text-dark">$@Model.Price</span>
                            @if (Model.Discount > 0)
                            {
                                <span class="badge ms-2" style="background: #fee2e2; color: #ef4444;">-@Model.Discount% OFF</span>
                            }
                        </div>
                        <div class="text-end">
                            <div class="text-warning mb-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= Model.Rate ? "fas" : "far") fa-star"></i>
                                }
                            </div>
                            <span class="small text-muted fw-bold">(@Model.Rate.ToString("0.0") / 5.0 Rating)</span>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="small text-muted fw-bold text-uppercase mb-2 d-block">Description</label>
                        <p class="lh-lg text-secondary" style="font-size: 1.05rem;">@Model.Description</p>
                    </div>

                    <div class="row g-4 mb-5">
                        <div class="col-sm-6">
                            <div class="p-3 rounded-4 border bg-light">
                                <span class="d-block small text-muted fw-bold">CATEGORY</span>
                                <span class="fw-bold text-dark">@(Model.Category?.Name ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 rounded-4 border bg-light">
                                <span class="d-block small text-muted fw-bold">BRAND</span>
                                <span class="fw-bold text-dark">@(Model.Brand?.Name ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 rounded-4 border bg-light">
                                <span class="d-block small text-muted fw-bold">AVAILABILITY</span>
                                <span class="fw-bold @(Model.Quantity > 0 ? "text-success" : "text-danger")">
                                    @(Model.Quantity > 0 ? $"{Model.Quantity} In Stock" : "Out of Stock")
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 rounded-4 border bg-light">
                                <span class="d-block small text-muted fw-bold">STATUS</span>
                                @if (Model.Status)
                                {
                                    <span class="badge bg-success small">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary small">Inactive</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.Colors != null && Model.Colors.Any())
                    {
                        <div class="mb-5">
                            <label class="small text-muted fw-bold text-uppercase mb-3 d-block">Available Color Variants</label>
                            <div class="d-flex gap-3">
                                @foreach (var color in Model.Colors)
                                {
                                    <div class="color-swatch-container" title="@color.Color">
                                        <div class="color-swatch shadow-sm" style="background-color:@color.Color; width: 40px; height: 40px; border-radius: 50%; border: 3px solid #fff; outline: 1px solid #e2e8f0;"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <hr class="my-5 opacity-25">

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold text-muted border-0" style="border-radius: 12px; background: #f1f5f9;">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn text-white px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 12px;">
                            <i class="fas fa-edit me-1"></i> Edit Product
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .gallery-item img {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }
    .gallery-item img:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
    }
    .color-swatch-container {
        transition: transform 0.2s;
    }
    .color-swatch-container:hover {
        transform: scale(1.2);
    }
</style>
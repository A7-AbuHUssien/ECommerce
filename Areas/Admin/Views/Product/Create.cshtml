@using ECommerce.ViewModels
@model ProductVM

@{
    ViewData["Title"] = "Create Product";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/Admin/" class="text-decoration-none" style="color: #764ba2;">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: #764ba2;">Products</a></li>
            <li class="breadcrumb-item active">New Product</li>
        </ol>
    </nav>

    <form asp-action="Create" enctype="multipart/form-data">
        <div class="row">
            <div class="col-xl-8">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
                    <div class="card-header py-3 border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <h5 class="mb-0 text-white fw-bold"><i class="fas fa-info-circle me-2"></i>General Information</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Product!.Name" class="form-label fw-bold" style="color: #2c3e50;">Product Name</label>
                                <input asp-for="Product!.Name" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" placeholder="e.g. Premium Wireless Headphones" />
                                <span asp-validation-for="Product!.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Product!.SKU" class="form-label fw-bold" style="color: #2c3e50;">SKU Code</label>
                                <input asp-for="Product!.SKU" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" placeholder="PRD-XXXX" />
                                <span asp-validation-for="Product!.SKU" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Product!.Description" class="form-label fw-bold" style="color: #2c3e50;">Full Description</label>
                                <textarea asp-for="Product!.Description" class="form-control bg-light border-0" rows="5" style="border-radius: 10px;" placeholder="Tell customers more about this product..."></textarea>
                                <span asp-validation-for="Product!.Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
                    <div class="card-header py-3 border-0 bg-white">
                        <h5 class="mb-0 fw-bold" style="color: #764ba2;"><i class="fas fa-tags me-2"></i>Pricing & Inventory</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Product!.Price" class="form-label fw-bold" style="color: #2c3e50;">Base Price ($)</label>
                                <input asp-for="Product!.Price" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" />
                                <span asp-validation-for="Product!.Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Product!.Discount" class="form-label fw-bold" style="color: #2c3e50;">Discount (%)</label>
                                <input asp-for="Product!.Discount" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" />
                                <span asp-validation-for="Product!.Discount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Product!.Quantity" class="form-label fw-bold" style="color: #2c3e50;">Stock Quantity</label>
                                <input asp-for="Product!.Quantity" class="form-control bg-light border-0 py-2" style="border-radius: 10px;" />
                                <span asp-validation-for="Product!.Quantity" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
                    <div class="card-header py-3 border-0 bg-white">
                        <h5 class="mb-0 fw-bold" style="color: #764ba2;"><i class="fas fa-layer-group me-2"></i>Organization</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #2c3e50;">Category</label>
                            <select asp-for="Product!.CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))" class="form-select bg-light border-0 py-2" style="border-radius: 10px;">
                                <option value="">-- Choose Category --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="color: #2c3e50;">Brand</label>
                            <select asp-for="Product!.BrandId" asp-items="@(new SelectList(Model.Brands, "Id", "Name"))" class="form-select bg-light border-0 py-2" style="border-radius: 10px;">
                                <option value="">-- Choose Brand --</option>
                            </select>
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-bold" style="color: #2c3e50;">Display Status</label>
                            <select asp-for="Product!.Status" class="form-select bg-light border-0 py-2" style="border-radius: 10px;">
                                <option value="true">Active & Visible</option>
                                <option value="false">Hidden / Draft</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
                    <div class="card-header py-3 border-0 bg-white">
                        <h5 class="mb-0 fw-bold" style="color: #764ba2;"><i class="fas fa-images me-2"></i>Media & Colors</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Main Cover Image</label>
                            <input type="file" name="file" class="form-control border-0 bg-light py-2" style="border-radius: 10px;" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Product Gallery (Multi)</label>
                            <input type="file" name="subfiles" class="form-control border-0 bg-light py-2" style="border-radius: 10px;" multiple />
                        </div>
                        
                        <div class="mb-0">
                            <label class="form-label fw-bold small d-block mb-3">Available Colors</label>
                            <div id="color-picker-container">
                                <div class="d-flex mb-2 align-items-center">
                                    <input type="color" name="colors" class="form-control form-control-color border-0 bg-transparent me-2" value="#667eea" style="width: 50px; height: 40px;" />
                                    <button type="button" class="btn btn-sm text-white" style="background: #764ba2; border-radius: 8px;" onclick="addColorPicker()">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mb-5 p-3 bg-white shadow-sm border rounded-4">
            <a asp-action="Index" class="btn btn-light px-4 fw-bold text-muted border-0" style="background: #f1f5f9; border-radius: 12px;">
                <i class="fas fa-times me-1"></i> Cancel
            </a>
            <button type="submit" class="btn text-white px-5 fw-bold shadow-sm" 
                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 12px;">
                <i class="fas fa-cloud-upload-alt me-1"></i> Create Product
            </button>
        </div>
    </form>
</div>

<script>
    function addColorPicker() {
        const container = document.getElementById("color-picker-container");
        const div = document.createElement("div");
        div.className = "d-flex mb-2 align-items-center animate__animated animate__fadeIn";
        div.innerHTML = `
            <input type="color" name="colors" class="form-control form-control-color border-0 bg-transparent me-2" value="#000000" style="width: 50px; height: 40px;" />
            <button type="button" class="btn btn-sm btn-light text-danger border" style="border-radius: 8px;" onclick="this.parentElement.remove()">
                <i class="fas fa-trash-alt"></i>
            </button>
        `;
        container.appendChild(div);
    }
</script>

<style>
    .form-control:focus, .form-select:focus {
        background-color: #fff !important;
        border: 1px solid #764ba2 !important;
        box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.1) !important;
    }
    .form-control-color::-webkit-color-swatch {
        border-radius: 8px;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #e2e8f0;
    }
    </ol>
</style>
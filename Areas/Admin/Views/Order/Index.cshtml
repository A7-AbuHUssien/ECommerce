@model IEnumerable<Order>

@{
    ViewBag.Title = "OrderPage";
    Layout = "_AdminLayout";
}
<div class="container-fluid px-4 mt-4">
    <h1 class="mt-4 fw-bold">Orders Management</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin/Home">Dashboard</a></li>
        <li class="breadcrumb-item active">Orders</li>
    </ol>

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4 shadow border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Orders</h5>
                    <h2 class="fw-bold">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4 shadow border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Sales</h5>
                    <h2 class="fw-bold">@Model.Sum(o => o.Total).ToString("N0") EGP</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex align-items-center">
            <i class="bi bi-table me-2"></i>
            <span class="fw-bold">All Orders List</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small fw-bold">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@order.Id</td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">@order.User?.UserName</span>
                                        <small class="text-muted">@order.User?.Email</small>
                                    </div>
                                </td>
                                <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="fw-bold text-dark">@order.Total.ToString("N2") EGP</td>
                                <td>
                                    @if (order.PaymentStatus?.ToLower() == "paid")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning px-3">Pending</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var statusColor = order.OrderStatus switch
                                        {
                                            "Processing" => "bg-warning-subtle text-warning border-warning",
                                            "Shipped" => "bg-info-subtle text-info border-info",
                                            "Delivered" => "bg-success-subtle text-success border-success",
                                            "Cancelled" => "bg-danger-subtle text-danger border-danger",
                                            _ => "bg-secondary-subtle text-secondary border-secondary"
                                        };
        
                                        var statusIcon = order.OrderStatus switch
                                        {
                                            "Processing" => "bi-gear-fill",
                                            "Shipped" => "bi-truck",
                                            "Delivered" => "bi-check-all",
                                            "Cancelled" => "bi-x-circle",
                                            _ => "bi-question-circle"
                                        };
                                    }

                                    <span class="badge rounded-pill border @statusColor px-3 py-2">
                                        <i class="bi @statusIcon me-1"></i> @order.OrderStatus
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-guid="@order.OrderGuid" class="btn btn-sm btn-info text-white rounded-pill px-3 shadow-sm">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}
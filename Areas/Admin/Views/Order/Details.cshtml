@model Order

@{
    ViewData["Title"] = "Order Details #" + Model.Id;
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Order Details: <span class="text-primary">#@Model.Id</span></h1>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill shadow-sm">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-person-circle me-2"></i>Customer Info
                </div>
                <div class="card-body">
                    <p class="mb-1 text-muted small text-uppercase fw-semibold">Customer Name</p>
                    <h6 class="fw-bold text-dark">@ViewBag.CustomerName</h6>
                    <hr class="my-3">
                    <p class="mb-1 text-muted small text-uppercase fw-semibold">Email Address</p>
                    <h6 class="fw-bold text-dark">@ViewBag.CustomerEmail</h6>
                    <hr class="my-3">
                    <p class="mb-1 text-muted small text-uppercase fw-semibold">Phone Number</p>
                    <h6 class="fw-bold text-dark">@(ViewBag.CustomerPhone ?? "N/A")</h6>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-info-circle me-2"></i>Order Summary
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Order Date:</span>
                        <span class="fw-bold text-dark">@Model.OrderDate.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Payment:</span>
                        <span class="badge @(Model.PaymentStatus == "Paid" ? "bg-success" : "bg-warning") px-3">
                            @Model.PaymentStatus
                        </span>
                    </div>
                    
                    <hr class="my-3">
                    
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="orderId" value="@Model.Id" />

                        <label class="small text-muted mb-1 text-uppercase fw-semibold">Management Status</label>
    
                        <div class="input-group">
                            <select name="newStatus" class="form-select border-primary" onchange="this.form.submit()">
                                <!option value="Processing" @(Model.OrderStatus == "Processing" ? "selected" : "")>Processing</!option>
                                <!option value="Shipped" @(Model.OrderStatus == "Shipped" ? "selected" : "")>Shipped</!option>
                                <!option value="Delivered" @(Model.OrderStatus == "Delivered" ? "selected" : "")>Delivered</!option>
                                <!option value="Cancelled" @(Model.OrderStatus == "Cancelled" ? "selected" : "")>Cancelled</!option>
                            </select>
                        </div>
    
                        <small class="text-muted mt-2 d-block italic">Changing this will trigger an auto-save.</small>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold py-3 d-flex align-items-center">
                    <i class="bi bi-cart-check me-2 text-primary"></i>Purchased Items
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-uppercase small">
                                    <th class="ps-4 py-3">Product Name</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@item.Product?.Name</div>
                                            <div class="text-muted x-small">Product ID: @item.ProductId</div>
                                        </td>
                                        <td class="text-center fw-semibold">@item.Quantity</td>
                                        <td class="text-end">@item.Price.ToString("N2") EGP</td>
                                        <td class="text-end pe-4 fw-bold text-dark">
                                            @((item.Price * item.Quantity).ToString("N2")) EGP
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light border-top-0">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold py-4">Total Amount Paid:</td>
                                    <td class="text-end pe-4 fw-bold text-primary h4 py-4 mb-0">
                                        @Model.Total.ToString("N2") <span class="small">EGP</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .x-small { font-size: 0.75rem; }
        .bg-success-subtle { background-color: #d1e7dd; color: #0f5132; }
    </style>
}
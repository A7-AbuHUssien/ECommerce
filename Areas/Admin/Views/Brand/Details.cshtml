@model Brand

@{
    ViewData["Title"] = "Brand Details";
    Layout = "_AdminLayout";  
}

<div class="container-fluid px-4 mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/Admin/" class="text-decoration-none" style="color: #764ba2;">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: #764ba2;">Brands</a></li>
            <li class="breadcrumb-item active">Brand Profile</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header py-4 border-0 text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h4 class="mb-0 text-white fw-bold">
                        <i class="fas fa-info-circle me-2"></i>Brand Information
                    </h4>
                </div>

                <div class="card-body p-5 bg-white">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center mb-4 mb-md-0">
                            <div class="p-3 shadow-sm d-inline-block bg-white" style="border-radius: 15px; border: 1px solid #f0f0f0;">
                                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                                {
                                    <img src="~/Uploads/Brand/@Model.Logo" 
                                         alt="@Model.Name Logo" 
                                         class="img-fluid"
                                         style="max-width: 150px; height: 150px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center" 
                                         style="width: 150px; height: 150px; background: #f8fafc; border-radius: 10px;">
                                        <i class="fas fa-image text-muted mb-2" style="font-size: 2.5rem;"></i>
                                        <span class="text-muted small fw-bold">No Logo</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-8">
                            <div class="ps-md-4">
                                <h2 class="fw-bold mb-1" style="color: #2c3e50;">@Model.Name</h2>
                                <p class="text-muted mb-4 small"><i class="fas fa-fingerprint me-2"></i>Brand ID: #@Model.Id</p>

                                <div class="mb-3">
                                    <label class="text-uppercase small fw-bold text-muted d-block mb-1">Status</label>
                                    @if (Model.Status)
                                    {
                                        <span class="badge px-3 py-2 fw-bold" style="background: #dcfce7; color: #16a34a; border-radius: 8px;">
                                            <i class="fas fa-check-circle me-1"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge px-3 py-2 fw-bold" style="background: #fee2e2; color: #ef4444; border-radius: 8px;">
                                            <i class="fas fa-times-circle me-1"></i> Inactive
                                        </span>
                                    }
                                </div>

                                <div>
                                    <label class="text-uppercase small fw-bold text-muted d-block mb-1">Description</label>
                                    <p class="text-secondary lh-base" style="font-size: 0.95rem;">
                                        @if (string.IsNullOrWhiteSpace(Model.Description))
                                        {
                                            <span class="fst-italic opacity-50">No description provided for this brand.</span>
                                        }
                                        else
                                        {
                                            @Model.Description
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5 opacity-25">

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold text-muted border-0" style="border-radius: 10px; background: #f1f5f9;">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn text-white px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 10px;">
                            <i class="fas fa-edit me-1"></i> Edit Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
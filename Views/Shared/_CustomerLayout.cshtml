<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - E-STORE</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

    <style>
        :root {
            --primary-color: #2563eb; /* Modern Royal Blue */
            --dark-bg: #0f172a;       /* Slate 900 */
            --light-bg: #f8fafc;      /* Slate 50 */
            --text-main: #1e293b;     /* Slate 800 */
        }

        body { 
            background-color: var(--light-bg); 
            font-family: 'Inter', sans-serif; 
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
        }

        /* Glassmorphism Navbar */
        .navbar { 
            background: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 0.8rem 0;
            transition: all 0.3s ease;
        }

        .navbar-brand { 
            font-weight: 800; 
            font-size: 1.4rem;
            letter-spacing: -1px; 
            background: linear-gradient(45deg, var(--primary-color), #7c3aed);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link { 
            font-weight: 500; 
            color: #475569 !important;
            padding: 0.5rem 1rem !important;
            transition: 0.2s;
        }

        .nav-link:hover { color: var(--primary-color) !important; }

        /* Buttons & Components */
        .btn-primary { 
            background-color: var(--primary-color); 
            border: none;
            padding: 0.6rem 1.5rem;
            font-weight: 600;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

        .btn-outline-dark {
            border-color: #e2e8f0;
            color: var(--text-main);
            border-radius: 8px;
            font-weight: 500;
        }

        .btn-outline-dark:hover {
            background-color: var(--text-main);
            border-color: var(--text-main);
        }

        /* Cart Badge */
        .cart-badge {
            font-weight: 700;
            padding: 0.35em 0.6em;
            transform: translate(20%, -20%);
        }

        /* Footer Decoration */
        footer { 
            background: var(--dark-bg); 
            color: #94a3b8;
            margin-top: 5rem; 
        }
        
        footer h5, footer h6 { color: #fff; }

        /* Custom Dropdown Animation */
        .dropdown-menu {
            border: 1px solid #f1f5f9;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            border-radius: 12px;
            padding: 0.75rem;
            animation: fadeIn 0.2s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-light sticky-top border-bottom">
        <div class="container">
            <a class="navbar-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop-window me-2"></i>E-STORE
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer"  asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer"  asp-controller="Home" asp-action="About"> About </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-outline-dark position-relative border-0" asp-area="Customer" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-bag fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary cart-badge">
                            0
                        </span>
                    </a>
                    <a class="nav-item">
                        <a class="nav-link" asp-area="Customer"  asp-controller="Home" asp-action="ShowCustomerOrders"> My Orders </a>
                    </a>

                    <div class="vr mx-2 d-none d-lg-block text-secondary opacity-25"></div>

                    <ul class="navbar-nav">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-primary btn-sm" asp-area="Identity" asp-controller="Account" asp-action="Register">Get Started</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDrop" data-bs-toggle="dropdown">
                                    <div class="bg-light rounded-circle p-1 px-2 border text-primary">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-area="Identity" asp-controller="Profile" asp-action="Index">
                                        <i class="bi bi-gear me-2"></i>Settings
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form class="form-inline" asp-area="Identity" asp-controller="Account" asp-action="LogOut">
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                            }
                    </ul>
                </div>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="container" style="min-height: 75vh; padding-top: 3rem; padding-bottom: 3rem;">
    @RenderBody()
</main>

<footer class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <h5 class="fw-bold mb-4">E-STORE</h5>
                <p class="small opacity-75">Elevating your shopping experience with curated collections and premium quality service.</p>
                <div class="d-flex gap-3 mt-4">
                    <a href="#" class="text-white opacity-50 hover-opacity-100 fs-5"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-white opacity-50 hover-opacity-100 fs-5"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-white opacity-50 hover-opacity-100 fs-5"><i class="bi bi-twitter-x"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 ms-auto">
                <h6 class="text-uppercase small fw-bold mb-4">Shop</h6>
                <ul class="list-unstyled small d-grid gap-2">
                    <li><a href="#" class="text-decoration-none text-reset opacity-75">All Categories</a></li>
                    <li><a href="#" class="text-decoration-none text-reset opacity-75">Featured</a></li>
                    <li><a href="#" class="text-decoration-none text-reset opacity-75">Discounts</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-6">
                <h6 class="text-uppercase small fw-bold mb-4">Company</h6>
                <ul class="list-unstyled small d-grid gap-2">
                    <li><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-reset opacity-75">Privacy Policy</a></li>
                    <li><a href="#" class="text-decoration-none text-reset opacity-75">Terms of Use</a></li>
                    <li><a href="#" class="text-decoration-none text-reset opacity-75">Contact</a></li>
                </ul>
            </div>
        </div>
        <div class="mt-5 pt-4 border-top border-secondary border-opacity-25 text-center">
            <p class="small opacity-50 mb-0">&copy; 2026 E-STORE Inc. Built with Passion.</p>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

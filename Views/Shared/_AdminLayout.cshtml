<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
    <title>@ViewData["Title"] - Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet"/>
    <link href="~/css/Admin/styles.css" rel="stylesheet"/>
    <link href="~/css/Admin/modern-purple.css" rel="stylesheet" asp-append-version="true" />
    
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="sb-nav-fixed">
<nav class="sb-topnav navbar navbar-expand">
    <a class="navbar-brand ps-3" asp-area="Admin" asp-controller="Home" asp-action="Index">U_ADMIN</a>
    <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle"><i class="fas fa-bars-staggered"></i></button>
    
    <ul class="navbar-nav ms-auto me-3 me-lg-4">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown">
                <i class="fas fa-user-circle fa-xl" style="color: #764ba2;"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="navbarDropdown">
                <li><a class="dropdown-item" asp-area="Identity" asp-controller="Profile" asp-action="Index">Settings</a></li>
                <li><hr class="dropdown-divider"/></li>
                <li><a class="dropdown-item text-danger" asp-area="Identity" asp-controller="Account" asp-action="LogOut">Logout</a></li>
            </ul>
        </li>
    </ul>
</nav>

<div id="layoutSidenav">
    <div id="layoutSidenav_nav">
        <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
            <div class="sb-sidenav-menu">
                <div class="nav">
                    <div class="sb-sidenav-menu-heading">Core</div>
                    <a class="nav-link active" href="https://localhost:7038/Admin/">
                        <div class="sb-nav-link-icon"><i class="fas fa-chart-pie"></i></div>
                        Dashboard
                    </a>
                    
                    <div class="sb-sidenav-menu-heading">Management</div>
                    <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseLayouts">
                        <div class="sb-nav-link-icon"><i class="fas fa-box-archive"></i></div>
                        Models
                        <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                    </a>
                    <div class="collapse" id="collapseLayouts" data-bs-parent="#sidenavAccordion">
                        <nav class="sb-sidenav-menu-nested nav">
                            <a class="nav-link" href="https://localhost:7038/Admin/Category/">Category</a>
                            <a class="nav-link" href="https://localhost:7038/Admin/Brand/">Brands</a>
                            <a class="nav-link" href="https://localhost:7038/Admin/Product/">Products</a>
                            <a class="nav-link" href="https://localhost:7038/Admin/Order">Orders</a>
                            <a class="nav-link" href="https://localhost:7038/Admin/Promotion">Promotions</a>
                            <a class="nav-link" href="https://localhost:7038/Admin/User">Users</a>
                        </nav>
                    </div>

                    <div class="sb-sidenav-menu-heading">Authentication</div>
                    <a class="nav-link" href="https://localhost:7038/Identity/Account/Login/">
                        <div class="sb-nav-link-icon"><i class="fas fa-sign-in-alt"></i></div>
                        Login
                    </a>
                    <a class="nav-link" href="https://localhost:7038/Identity/Account/Register/">
                        <div class="sb-nav-link-icon"><i class="fas fa-user-plus"></i></div>
                        Register
                    </a>
                    <a class="nav-link" href="https://localhost:7038/Identity/Account/ForgotPassword/">
                        <div class="sb-nav-link-icon"><i class="fas fa-key"></i></div>
                        Forgot Password
                    </a>
                </div>
            </div>
            <div class="sb-sidenav-footer" style="background: #f8f9ff; border-top: 1px solid #eee;">
                <div class="small">System Status:</div>
                <span style="color: #764ba2; font-weight: 600;">Active & Secure</span>
            </div>
        </nav>
    </div>
    
    <div id="layoutSidenav_content">
        <main>
            <div class="container-fluid px-4 pt-4">
                @RenderBody()
            </div>
        </main>
        <footer class="py-4 mt-auto">
            <div class="container-fluid px-4 text-center">
                <div class="small text-muted">Copyright &copy; Your E-Commerce 2026</div>
            </div>
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/Admin/scripts.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>